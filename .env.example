APP_NAME="Asas Vantage"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://asaasvantage.com
PLATFORM_URL=https://app.asaasvantage.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
VITE_PLATFORM_URL="${PLATFORM_URL}"

# --- Local development override example ---
# APP_ENV=local
# APP_DEBUG=true
# APP_URL=http://asaas.local
# PLATFORM_URL=http://app.asaas.local
# SESSION_SECURE_COOKIE=false
# LOG_LEVEL=debug
